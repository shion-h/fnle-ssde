# Ignore everything by default
*

# Keep source directories traversable
!*/

.venv/

# Track source documents and notebooks
!*.py
!*.ipynb
!*.R

# Keep essential project metadata/config files
!.gitignore
!pyproject.toml
!uv.lock
!.python-version
!README*
!LICENSE*

# Data used or generated by the published examples
!data/didinium_paramecium.csv
!data/didinium_paramecium_div100.csv
!data/example_2_lv.pt
!data/example_2_cle.pt
!data/example_2_sir.pt

# Numerical results, trained NLEs, and MCMC histories for the published examples
!results/example1.pt
!results/example2_lv_nle.pt
!results/example2_cle_nle.pt
!results/example2_sir_nle.pt
!results/example2_lv_mcmc.pt
!results/example2_cle_mcmc.pt
!results/example2_sir_mcmc.pt
!results/example3_nle.pt
!results/example3_mcmc_chain[0-3].pt

# Paper figures generated by the published plotting scripts
!results/figures/example_1.png
!results/figures/example_1.pdf
!results/figures/example_2.png
!results/figures/example_2.pdf
!results/figures/example_3.png
!results/figures/example_3.pdf
!results/figures/example_3_multichain_trace.png
!results/figures/example_3_multichain_trace.pdf
!results/diagnostics/example_3_rhat.csv
!results/diagnostics/example_3_regime_alignment.csv

# Explicitly ignore common generated artifacts inside kept directories
scripts/archive/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.r-lib/
